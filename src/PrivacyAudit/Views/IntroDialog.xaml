<UserControl x:Class="PrivacyAudit.IntroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrivacyAudit"
        Background="#0B1019" Foreground="#F7F8FA">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="360"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="SlideBackground" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="720" Height="360" Stretch="UniformToFill" Opacity="0.92" IsHitTestVisible="False"/>
    <Border Grid.Row="1" Background="#66080B12" IsHitTestVisible="False"/>
    <Border Grid.Row="1" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#B30B101B" BorderBrush="#4B5A78" BorderThickness="1" CornerRadius="18" Padding="22" Margin="16,0,0,0">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
        <TextBlock x:Name="SlideTitle" Foreground="#C9A8FF" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,16"/>
        <TextBlock x:Name="SlideBody" Foreground="#F0F3FA" FontSize="14" LineHeight="22" TextWrapping="Wrap" TextAlignment="Left"/>
      </StackPanel>
    </Border>
    <CheckBox x:Name="DoNotShowAgain" Grid.Row="2" Content="{local:Loc IntroDoNotShow}" ToolTip="{local:Loc IntroDoNotShowTooltip}" Margin="16,12,0,0"/>
    <DockPanel Grid.Row="3" Margin="16,14,16,0">
      <Button x:Name="BackButton" DockPanel.Dock="Left" Click="Back_Click" Content="{local:Loc IntroBack}" ToolTip="{local:Loc IntroBackTooltip}" Padding="14,9"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="NextButton" Click="Next_Click" Content="{local:Loc IntroNext}" ToolTip="{local:Loc IntroNextTooltip}" Padding="14,9"/>
        <Button x:Name="OkButton" Click="Ok_Click" Content="{local:Loc IntroStart}" ToolTip="{local:Loc IntroStartTooltip}" Background="#0A84FF" Padding="18,9"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
