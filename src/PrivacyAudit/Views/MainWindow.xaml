 FeedbackOpacityConverter}, ConverterParameter=Clear}" ToolTip="{local:Loc ClearRating}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="FindingsLoadNextPanel" Grid.Row="0" Panel.ZIndex="5" VerticalAlignment="Bottom" Background="#F0162233" BorderBrush="#5A69B7FF" BorderThickness="1" CornerRadius="10" Padding="8,5" Margin="12,0,12,8" Visibility="Collapsed">
