      <StackPanel>
      <WrapPanel>
        <ComboBox x:Name="ApplicationHistoryAvailabilityFilter" Width="170" Margin="0,0,8,8" SelectionChanged="ApplicationHistoryFilter_Changed" ToolTip="{local:Loc ApplicationHistoryAvailabilityHelp}"><ComboBoxItem Content="{local:Loc ApplicationHistoryAllObjects}" Tag="All" IsSelected="True"/><ComboBoxItem Content="{local:Loc ApplicationHistoryAvailableObjects}" Tag="Available"/><ComboBoxItem Content="{local:Loc ApplicationHistoryMissingObjects}" Tag="Missing"/></ComboBox>
        <ComboBox x:Name="ApplicationHistoryPinnedFilter" Width="180" Margin="0,0,8,8" SelectionChanged="ApplicationHistoryFilter_Changed" ToolTip="{local:Loc ApplicationHistoryPinnedHelp}"><ComboBoxItem Content="{local:Loc ApplicationHistoryAllPinStates}" Tag="All" IsSelected="True"/><ComboBoxItem Content="{local:Loc ApplicationHistoryPinnedOnly}" Tag="Pinned"/><ComboBoxItem Content="{local:Loc ApplicationHistoryNotPinnedOnly}" Tag="NotPinned"/></ComboBox>
        <ComboBox x:Name="ApplicationHistoryRiskFilter" Width="190" Margin="0,0,8,8" SelectionChanged="ApplicationHistoryFilter_Changed" ToolTip="{local:Loc ApplicationHistoryRiskHelp}"><ComboBoxItem Content="{local:Loc ApplicationHistoryAllRiskStates}" Tag="All" IsSelected="True"/><ComboBoxItem Content="{local:Loc ApplicationHistoryWithFindings}" Tag="Finding"/><ComboBoxItem Content="{local:Loc ApplicationHistoryImportantOnly}" Tag="Important"/><ComboBoxItem Content="{local:Loc ApplicationHistoryWithoutFindings}" Tag="None"/></ComboBox>
        <ComboBox x:Name="ApplicationHistorySortFilter" Width="190" Margin="0,0,8,8" SelectionChanged="ApplicationHistoryFilter_Changed" ToolTip="{local:Loc ApplicationHistoryAvailabilitySortHelp}"><ComboBoxItem Content="{local:Loc ApplicationHistorySortDefault}" Tag="Default" IsSelected="True"/><ComboBoxItem Content="{local:Loc ApplicationHistorySortAi}" Tag="AiPriority"/></ComboBox>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8"><TextBlock Text="{local:Loc FilterSize}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/><Slider x:Name="ApplicationHistorySizeSlider" VerticalAlignment="Center" Minimum="0" Maximum="9" Value="0" Width="95" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ApplicationHistoryFilter_SliderChanged" ToolTip="{local:Loc FilterSizeHelp}"/><TextBlock x:Name="ApplicationHistorySizeLabel" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8"><TextBlock Text="{local:Loc FilterAge}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/><Slider x:Name="ApplicationHistoryAgeSlider" VerticalAlignment="Center" Minimum="0" Maximum="8" Value="0" Width="95" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ApplicationHistoryFilter_SliderChanged" ToolTip="{local:Loc FilterAgeHelp}"/><TextBlock x:Name="ApplicationHistoryAgeLabel" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
        <TextBox x:Name="ApplicationHistorySearchBox" Width="220" Height="34" Margin="0,0,8,8" TextChanged="ApplicationHistorySearch_TextChanged" ToolTip="{local:Loc ApplicationHistorySearchHelp}"/>
        <Button Click="ApplicationHistoryResetFilters_Click" Content="{local:Loc ResetFilters}" Padding="12,7" Margin="0,0,0,8" ToolTip="{local:Loc ResetFiltersHelp}"/>
      </WrapPanel>
      <TextBlock Text="{local:Loc AccuracyDisclaimer}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,4,2,0" FontSize="11"/>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="ApplicationHistoryScrollViewer" Grid.Row="4" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ApplicationHistoryList">
        <ItemsControl.ItemTemplate><DataTemplate><Expander Margin="0,0,0,10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
          <Expander.Header><StackPanel><TextBlock Text="{Binding Identity.DisplayName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><TextBlock Foreground="#929AAA"><Run Text="{Binding Entries.Count, Mode=OneWay}"/><Run Text=" "/><Run Text="{local:Loc ApplicationHistoryObjects}"/><Run Text=" · "/><Run Text="{Binding MissingTargets, Mode=OneWay}"/><Run Text=" "/><Run Text="{local:Loc ApplicationHistoryMissing}"/><Run Text=" · "/><Run Text="{Binding SensitiveObjects, Mode=OneWay}"/><Run Text=" "/><Run Text="{local:Loc ApplicationHistorySensitive}"/><Run Text=" · "/><Run Text="{local:Loc PersonalModelShort}"/><Run Text=": "/><Run Text="{Binding PersonalAttentionDisplay, Mode=OneWay}"/></TextBlock></StackPanel></Expander.Header>
          <ItemsControl ItemsSource="{Binding Entries, Mode=OneWay}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#243044" BorderThickness="0,1,0,0" Padding="6,11" PreviewMouseLeftButtonDown="ApplicationHistoryEntry_MouseLeftButtonDown"><Border.ContextMenu><ContextMenu Opened="ApplicationHistoryContextMenu_Opened"><MenuItem Header="{local:Loc OpenFile}" Click="ApplicationHistoryOpen_Click"/><MenuItem Header="{local:Loc ShowExplorer}" Click="ApplicationHistoryShowFolder_Click"/><MenuItem Header="{local:Loc DeleteFile}" Click="ApplicationHistoryDelete_Click"/><MenuItem Header="{local:Loc CopyPath}" Click="ApplicationHistoryCopyPath_Click"/></ContextMenu></Border.ContextMenu><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding TargetPath, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Foreground="#929AAA" Margin="0,4,0,0"><Run Text="{local:Loc ApplicationHistoryLastInteraction}"/><Run Text=": "/><Run Text="{Binding LastInteractionDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{local:Loc ApplicationHistoryOpened}"/><Run Text=": "/><Run Text="{Binding InteractionCountDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{local:Loc Size}"/><Run Text=": "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/></TextBlock></StackPanel><StackPanel Grid.Column="1" Width="330" HorizontalAlignment="Right"><TextBlock Text="{Binding EffectiveRisk, Mode=OneWay, Converter={StaticResource ApplicationHistoryRiskConverter}}" Foreground="#FFB340" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/><TextBlock Foreground="#929AAA" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"><Run Text="{local:Loc ApplicationHistoryAvailableNow}"/><Run Text=": "/><Run Text="{Binding ExistsNow, Mode=OneWay, Converter={StaticResource LocalizedBooleanConverter}}"/><Run Text=" · "/><Run Text="{local:Loc ApplicationHistoryPinnedFriendly}"/><Run Text=": "/><Run Text="{Binding IsPinned, Mode=OneWay, Converter={StaticResource LocalizedBooleanConverter}}"/></TextBlock><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"><TextBlock Text="{Binding PersonalAttentionDisplay, Mode=OneWay}" Foreground="#69B7FF" Width="42" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,5,0"/><Button Content="👍" Tag="True" Click="ApplicationHistoryPersonalFeedback_Click" Padding="4,2" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=True}" Background="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackBackgroundConverter}, ConverterParameter=True}" ToolTip="{local:Loc Interesting}"/><Button Content="👎" Tag="False" Click="ApplicationHistoryPersonalFeedback_Click" Padding="4,2" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=False}" Background="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackBackgroundConverter}, ConverterParameter=False}" ToolTip="{local:Loc NotInteresting}"/><Button Content="×" Tag="Clear" Click="ApplicationHistoryPersonalFeedback_Click" Padding="4,2" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=Clear}" ToolTip="{local:Loc ClearRating}"/></StackPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Expander></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</TabItem>
<TabItem x:Name="TabDetails" Header="{local:Loc NavDetails}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="{local:Loc DetailsTitle}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{local:Loc DetailsDescription}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,5,0,0"/><TextBlock Text="{local:Loc AccuracyDisclaimer}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel>
            <Button x:Name="DetailsBackButton" Click="DetailsBack_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,10" Visibility="Collapsed" ContentTemplate="{x:Null}" ToolTip="{local:Loc DetailsBackTooltip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="←" Margin="0,0,6,0"/>
                <TextBlock Text="{local:Loc DetailsBack}"/>
              </StackPanel>
            </Button>
            <!-- Image / Media Preview (visible only when finding is an image) -->
            <Border x:Name="DetailsImagePreviewBorder" DockPanel.Dock="Top" Background="#0DFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,0,12" HorizontalAlignment="Left" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Border CornerRadius="8" ClipToBounds="True" Background="#08FFFFFF" MaxHeight="140" MaxWidth="240">
                  <Image x:Name="DetailsImagePreview" Stretch="Uniform"/>
                </Border>
                <StackPanel Margin="12,4,8,0" VerticalAlignment="Top">
                  <TextBlock x:Name="DetailsImageDimensions" Style="{StaticResource MutedText}" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DetailsImageFormat" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ProvenanceDetailsPanel" Visibility="Collapsed" Background="#081C2A3A" BorderBrush="#284A67" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,10,6,2">
                <TextBlock x:Name="ProvenanceDetailsText" TextWrapping="Wrap" Foreground="#A9C8E5" FontSize="12"/>
            </Border>
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas" Background="Transparent" BorderThickness="0" Padding="6"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border x:Name="SimilarSectionBorder" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,14,0,0" Visibility="Collapsed" MaxHeight="270">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
              <TextBlock x:Name="SimilarSectionTitle" Text="{local:Loc SimilarFindingsTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Click="CloseSimilarSection_Click" HorizontalAlignment="Right" Padding="6,2"/>
            </DockPanel>
            <StackPanel x:Name="SimilarProgressContainer" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
              <ProgressBar x:Name="SimilarProgress" Height="5" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,4"/>
              <TextBlock x:Name="SimilarProgressText" Style="{StaticResource MutedText}" FontSize="11"/>
              <WrapPanel Margin="0,7,0,0">
                <Button x:Name="SimilarPauseButton" Click="SimilarPause_Click" Content="{local:Loc PauseScan}" Padding="10,5" Margin="0,0,6,0" ToolTip="{local:Loc SimilarPauseHelp}"/>
                <Button x:Name="SimilarResumeButton" Click="SimilarResume_Click" Content="{local:Loc SimilarResume}" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" ToolTip="{local:Loc SimilarResumeHelp}"/>
                <Button x:Name="SimilarCancelButton" Click="SimilarCancel_Click" Content="{local:Loc CancelScan}" Padding="10,5" ToolTip="{local:Loc SimilarCancelHelp}"/>
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="SimilarEmptyText" Grid.Row="2" Text="{local:Loc NoSimilarFound}" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,8,0,0"/>
            <ListBox x:Name="SimilarFindingsList" Grid.Row="2" Background="Transparent" BorderThickness="0" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="SimilarItem_Selected" MouseDoubleClick="SimilarItem_DoubleClick">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Padding" Value="2,2"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#0DFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,2">
                    <DockPanel>
                      <Border Background="#1F0A84FF" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScorePercentage, StringFormat={}{0}%}" Foreground="#69B7FF" FontWeight="Bold" FontSize="11"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Finding.DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Finding.Path}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
      <ScrollViewer Grid.Column="1" Margin="18,0,0,0" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Opacity" Value="0.62"/>
          </Style>
        </ScrollViewer.Resources>
      <StackPanel>
        <TextBlock Text="{local:Loc Actions}" Style="{StaticResource SectionTitle}"/>
        <Button x:Name="FindSimilarButton" Click="FindSimilar_Click" Content="{local:Loc FindSimilarDocuments}" Background="#1F0A84FF" Foreground="#69B7FF" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button x:Name="OpenDetailsFileButton" Click="Open_Click" Content="{local:Loc OpenFile}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Click="Folder_Click" Content="{local:Loc ShowExplorer}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Click="Copy_Click" Content="{local:Loc CopyPath}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Click="Ignore_Click" Content="{local:Loc IgnoreFinding}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Click="Exclude_Click" Content="{local:Loc ExcludePath}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button x:Name="DeleteDetailsFileButton" Style="{StaticResource DangerButton}" Click="DeleteDetailsFile_Click" Content="{local:Loc DeleteFile}" HorizontalContentAlignment="Left" Margin="0,0,0,24" ToolTip="{local:Loc DeleteFileDetailsHelp}"/>
        <TextBlock Text="{local:Loc IncorrectDetectionQuestion}" Style="{StaticResource SectionTitle}" FontSize="16" FontWeight="Bold" Foreground="#C09BFF" Margin="0,0,0,4"/>
        <Button Click="ReportIncorrectDetection_Click" Content="{local:Loc ReportIncorrectDetection}" HorizontalContentAlignment="Left" Margin="0,0,0,24" Background="#2849306A" Foreground="#CBB0F2" BorderBrush="#7650A6" ToolTip="{local:Loc ReportIncorrectDetectionTooltip}"/>
        <TextBlock Text="{local:Loc FileProvenanceTitle}" Style="{StaticResource SectionTitle}" FontSize="16" FontWeight="Bold" Foreground="#79C7FF" Margin="0,0,0,4"/>
        <Button x:Name="ProvenanceAnalyzeButton" Click="AnalyzeProvenance_Click" Content="{local:Loc InvestigateProvenance}" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="{local:Loc InvestigateProvenanceTooltip}"/>
        <Button x:Name="ProvenanceWhyButton" Click="ShowProvenanceWhy_Click" Content="{local:Loc ProvenanceWhy}" HorizontalContentAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8" ToolTip="{local:Loc ProvenanceWhy}"/>
        <Button x:Name="ProvenanceCancelButton" Click="CancelProvenance_Click" Content="{local:Loc CancelProvenance}" HorizontalContentAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8" ToolTip="{local:Loc CancelProvenanceTooltip}"/>
        <TextBlock Text="{local:Loc PersonalModel}" Style="{StaticResource SectionTitle}" FontSize="16" FontWeight="Bold" Foreground="#C09BFF" Margin="0,18,0,4" TextWrapping="Wrap" Width="240"/>
        <TextBlock x:Name="PersonalModelStatsText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Click="ShowPersonalModelInfo_Click" Content="{local:Loc PersonalModelInfoShow}" ToolTip="{local:Loc PersonalModelInfoTooltip}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button x:Name="PersonalRetrainButton" Click="PersonalRetrain_Click" Content="{local:Loc RetrainPersonalModel}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button x:Name="PersonalCancelButton" Click="PersonalCancel_Click" Content="{local:Loc CancelTraining}" HorizontalContentAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8"/>
        <Button Style="{StaticResource DangerButton}" Click="DeletePersonalAll_Click" Content="{local:Loc DeletePersonalAll}" HorizontalContentAlignment="Left" Margin="0,0,0,24"/>
        <TextBlock Text="{local:Loc Privacy}" Style="{StaticResource SectionTitle}"/>
        <Button Style="{StaticResource DangerButton}" Click="DeleteDb_Click" Content="{local:Loc DeleteAudits}" HorizontalContentAlignment="Left"/>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</TabItem></TabControl>
<Border x:Name="ModalOverlay" Panel.ZIndex="100" Visibility="Collapsed" Background="#B8000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <Border Width="760" MaxWidth="900" MaxHeight="760" Background="#0B1019" BorderBrush="#34536F" BorderThickness="1" CornerRadius="16" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="18,14,12,4">
        <Button x:Name="ModalCloseButton" DockPanel.Dock="Right" Click="CloseModal_Click" Content="✕" FontSize="16" Padding="8,2" Background="Transparent" ToolTip="Закрыть это окно"/>
        <TextBlock x:Name="ModalTitleText" FontSize="18" FontWeight="SemiBold" Foreground="#B996FF" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
      <ContentControl x:Name="ModalContentHost" Grid.Row="1" Margin="8,0,8,8"/>
    </Grid>
  </Border>
</Border>
</Grid></Window>


