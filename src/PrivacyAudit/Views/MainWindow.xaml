        </Border>
        <DockPanel Grid.Row="1" Margin="8,8,8,2">
          <StackPanel Orientation="Horizontal"><Button Click="PreviousFindingsPage_Click" Content="{local:Loc PreviousPage}" Padding="12,7" ToolTip="{local:Loc PreviousPageHelp}"/><Button Click="NextFindingsPage_Click" Content="{local:Loc NextPage}" Padding="12,7" ToolTip="{local:Loc NextPageHelp}"/></StackPanel>
          <TextBlock x:Name="FindingsPageStatus" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
