<Window x:Class="PrivacyAudit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PrivacyAudit" Title="NotBad Privacy Detector Agent" Icon="pack://application:,,,/NotBadPrivacyDetectorAgent;component/Assets/PrivacyAudit.ico" Width="1380" Height="860" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#080B12" Foreground="#F7F8FA" PreviewMouseDown="Window_PreviewMouseDown">
<Grid>
<TabControl x:Name="MainTabs" Style="{StaticResource SideTabs}">
<TabItem x:Name="TabOverview" Header="{local:Loc NavOverview}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="{local:Loc Greeting}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{local:Loc GreetingSubtitle}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#10FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="14,7" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse x:Name="AdminDot" Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,8,0"/><TextBlock x:Name="AdminText" FontSize="12" Margin="0,0,14,0"/><Button x:Name="ElevateButton" Click="Elevate_Click" Content="{local:Loc Elevate}" Padding="10,5" FontSize="11" Background="#1A0A84FF"/></StackPanel></Border></DockPanel>
<Border Grid.Row="1" CornerRadius="24" Padding="28" Margin="0,0,0,22">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#192E5B"/><GradientStop Color="#152B52" Offset="0.45"/><GradientStop Color="#143C42" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,34,0">
      <StackPanel x:Name="PrivacyRadarIntroPanel">
        <Border Background="#22FFFFFF" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="⌁" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="{local:Loc PrivacyRadarTitle}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{local:Loc PrivacyRadarDescription}" TextWrapping="Wrap" Foreground="#C8D4E8" FontSize="14" LineHeight="21" Margin="0,8,0,20"/>
      </StackPanel>
      <StackPanel x:Name="PriorityAuditWizardPanel" Visibility="Collapsed" Margin="0,0,0,16">
        <TextBlock Text="{local:Loc PriorityWizardTitle}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{local:Loc AccuracyDisclaimer}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel x:Name="PriorityWizardReadyPanel">
          <TextBlock x:Name="PriorityWizardReadyText" TextWrapping="Wrap" Foreground="#C8D4E8" FontSize="14" LineHeight="21" Margin="0,8,0,14"/>
          <ProgressBar x:Name="PriorityWizardPreparationProgress" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,8" Visibility="Collapsed"/>
          <TextBlock x:Name="PriorityWizardPreparationProgressText" Style="{StaticResource MutedText}" Margin="0,0,0,10" Visibility="Collapsed"/>
          <TextBlock x:Name="PriorityWizardPlanText" Foreground="#9FE6B0" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <WrapPanel>
            <Button x:Name="PriorityWizardPrepareButton" Style="{StaticResource PrimaryButton}" Click="PriorityWizardPrepare_Click" Content="{local:Loc PriorityWizardPrepare}" HorizontalAlignment="Left" ToolTip="{local:Loc PriorityWizardPrepareHelp}" Visibility="Collapsed"/>
            <Button x:Name="PriorityWizardCancelPreparationButton" Click="PriorityWizardCancelPreparation_Click" Content="{local:Loc PriorityWizardCancelPreparation}" HorizontalAlignment="Left" ToolTip="{local:Loc PriorityWizardCancelPreparationHelp}" Visibility="Collapsed"/>
            <Button x:Name="PriorityWizardStartButton" Style="{StaticResource PrimaryButton}" Click="PriorityWizardStart_Click" Content="{local:Loc PriorityWizardStart}" Background="#1FFF9F0A" Foreground="#FFD36A" BorderBrush="#FF9F0A" FontWeight="SemiBold" HorizontalAlignment="Left" ToolTip="{local:Loc PriorityWizardStartHelp}"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel x:Name="PriorityWizardRunningPanel" Visibility="Collapsed">
          <TextBlock x:Name="PriorityWizardStageText" TextWrapping="Wrap" Foreground="#C8D4E8" Margin="0,8,0,8"/>
          <ProgressBar x:Name="PriorityWizardProgress" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,8"/>
          <TextBlock x:Name="PriorityWizardProgressText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="{local:Loc PriorityWizardPartialNotice}" Foreground="#FFD36A" TextWrapping="Wrap" FontSize="12" LineHeight="17" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PriorityWizardPauseButton" Click="PriorityWizardPause_Click" Content="{local:Loc PauseScan}" ToolTip="{local:Loc PriorityWizardPauseHelp}"/>
            <Button x:Name="PriorityWizardCancelButton" Click="PriorityWizardCancel_Click" Content="{local:Loc CancelScan}" ToolTip="{local:Loc PriorityWizardCancelHelp}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="PriorityWizardCompletePanel" Visibility="Collapsed">
          <TextBlock x:Name="PriorityWizardCompleteText" TextWrapping="Wrap" Foreground="#9FE6B0" FontSize="14" LineHeight="21" Margin="0,8,0,14"/>
          <Button x:Name="PriorityWizardReportButton" Style="{StaticResource PrimaryButton}" Click="PriorityWizardReport_Click" Content="{local:Loc PriorityWizardOpenReport}" HorizontalAlignment="Left" ToolTip="{local:Loc PriorityWizardOpenReportHelp}"/>
          <Button x:Name="PriorityWizardFullReportButton" Click="PriorityWizardFullReport_Click" Content="{local:Loc OpenFullReport}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="{local:Loc OpenFullReportHelp}"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <Border x:Name="ScanSettingsPanel" Grid.Column="1" Background="#40000000" CornerRadius="18" Padding="20">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{local:Loc ScanSettings}" FontWeight="SemiBold" Margin="2,0,0,14"/>
        <ComboBox x:Name="PresetBox" Grid.Row="1" SelectedIndex="0" Margin="0,0,0,10" ToolTip="{local:Loc ScanPresetHelp}"><ComboBoxItem Content="{local:Loc PresetCustom}" Tag="Custom"/><ComboBoxItem Content="{local:Loc PresetQuick}" Tag="Quick"/><ComboBoxItem Content="{local:Loc PresetFull}" Tag="Full"/></ComboBox>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RootsBox" IsReadOnly="True" Height="36" Padding="12,0" VerticalContentAlignment="Center" ToolTip="{local:Loc BrowseFolderHelp}"/><Button Grid.Column="1" Click="BrowseRoot_Click" Content="{local:Loc ChooseFolder}" Width="150" Height="36" Padding="10,0" Margin="8,0,0,0" Background="#20FFFFFF" HorizontalContentAlignment="Center" ToolTip="{local:Loc BrowseFolderHelp}"/></Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <WrapPanel>
            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click" Content="{local:Loc StartScan}" ToolTip="{local:Loc StartScanHelp}" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Click="Cancel_Click" Content="{local:Loc StopScan}" IsEnabled="False" Visibility="Collapsed" ToolTip="{local:Loc StopScanHelp}"/>
          </WrapPanel>
          <Button x:Name="CancelRestoreButton" Click="CancelRestore_Click" Content="{local:Loc CancelSnapshotRestore}" Visibility="Collapsed" HorizontalAlignment="Left" ToolTip="{local:Loc CancelSnapshotRestoreHelp}" Margin="0,8,0,0"/>
          <Button x:Name="ReturnToPreviousAuditButton" Click="ReturnToPreviousAudit_Click" Content="{local:Loc BackToPreviousAudit}" Visibility="Collapsed" HorizontalAlignment="Left" ToolTip="{local:Loc BackToPreviousAuditHelp}" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="PreviousAuditPanel" Grid.Column="1" Background="#40000000" CornerRadius="18" Padding="20" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="{local:Loc PreviousAuditTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
        <TextBlock x:Name="PreviousAuditDatabaseText" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
        <TextBlock x:Name="PreviousAuditTypeText" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
        <TextBlock x:Name="PreviousAuditPathText" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxHeight="48" Margin="0,0,0,5"/>
        <TextBlock x:Name="PreviousAuditTimeText" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
        <TextBlock x:Name="PreviousAuditFindingsText" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
        <TextBlock x:Name="PreviousAuditEnrichmentText" Foreground="#9FE6B0" TextWrapping="Wrap" Margin="0,2,0,12"/>
        <Button x:Name="StartOverButton" Click="StartOver_Click" Content="{local:Loc StartOver}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" ToolTip="{local:Loc StartOverHelp}"/>
      </StackPanel>
    </Border>
  </Grid>
</Border>
<Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="2,0,2,10"><TextBlock Text="{local:Loc AuditResults}" FontSize="19" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="SCAN  →  CLASSIFY  →  REPORT" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border x:Name="EmptyDashboard" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="40" Margin="0,0,0,12"><StackPanel HorizontalAlignment="Center"><Border Width="62" Height="62" CornerRadius="31" Background="#140A84FF" Margin="0,6,0,16"><TextBlock Text="◎" Foreground="#69B7FF" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{local:Loc EmptyDashboard}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Loc EmptyDashboardDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620" Margin="0,7,0,6"/></StackPanel></Border><WrapPanel x:Name="DashboardPanel"/></StackPanel></ScrollViewer></Grid>
<Border Grid.Row="3" Margin="0,14,0,0" Background="#0DFFFFFF" CornerRadius="12" Padding="13,9"><DockPanel><ProgressBar x:Name="Busy" Width="130" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/><ProgressBar x:Name="CancellationProgress" Width="130" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/><TextBlock x:Name="CancellationText" Text="{local:Loc CancellationInProgress}" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,0,12,0"/><TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CountersText" DockPanel.Dock="Right" Foreground="#B9C2D1" FontSize="12"/></DockPanel></Border></Grid></TabItem>

<TabItem x:Name="TabPriorityReport" Header="{local:Loc PriorityReportNav}" Visibility="Collapsed">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="{local:Loc PriorityReportTitle}" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock x:Name="PriorityReportDescriptionText" Text="{local:Loc PriorityReportDescription}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#26FFB340" BorderBrush="#FFB340" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
      <TextBlock Text="{local:Loc PriorityReportPartialNotice}" Foreground="#FFD36A" TextWrapping="Wrap"/>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,12">
      <StackPanel>
      <WrapPanel>
        <ComboBox x:Name="PriorityReportRiskFilter" Width="155" Margin="0,0,8,8" SelectionChanged="PriorityReportFilter_Changed" ToolTip="{local:Loc RiskFilterHelp}"><ComboBoxItem Content="{local:Loc AllRisks}" Tag="All" IsSelected="True"/><ComboBoxItem Content="{local:Loc Critical}" Tag="Critical"/><ComboBoxItem Content="{local:Loc High}" Tag="High"/><ComboBoxItem Content="{local:Loc Medium}" Tag="Medium"/><ComboBoxItem Content="{local:Loc Low}" Tag="Low"/></ComboBox>
        <ComboBox x:Name="PriorityReportCategoryFilter" Width="180" Margin="0,0,8,8" SelectionChanged="PriorityReportFilter_Changed" ToolTip="{local:Loc CategoryFilterHelp}"/>
        <ComboBox x:Name="PriorityReportStatusFilter" Width="190" Margin="0,0,8,8" SelectionChanged="PriorityReportFilter_Changed" ToolTip="{local:Loc PriorityReportStatusHelp}"><ComboBoxItem Content="{local:Loc PriorityReportConfirmed}" Tag="Confirmed" IsSelected="True"/><ComboBoxItem Content="{local:Loc PriorityReportAllResearched}" Tag="All"/><ComboBoxItem Content="{local:Loc PriorityReportClear}" Tag="Clear"/><ComboBoxItem Content="{local:Loc PriorityReportErrors}" Tag="Errors"/></ComboBox>
        <ComboBox x:Name="PriorityReportSortFilter" Width="180" Margin="0,0,8,8" SelectionChanged="PriorityReportFilter_Changed" ToolTip="{local:Loc PriorityReportSortHelp}"><ComboBoxItem Content="{local:Loc PrivacyRisk}" Tag="Privacy" IsSelected="True"/><ComboBoxItem Content="{local:Loc PriorityReportDetectionSort}" Tag="Detection"/><ComboBoxItem Content="{local:Loc Modified}" Tag="Modified"/></ComboBox>
        <TextBox x:Name="PriorityReportSearchBox" Width="210" Height="34" Margin="0,0,8,8" TextChanged="PriorityReportSearch_Changed" ToolTip="{local:Loc SearchBoxHelp}"/>
        <StackPanel x:Name="PriorityReportImageModeControls" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,8">
          <Button x:Name="PriorityReportViewToggle" Click="TogglePriorityReportView_Click" Content="{local:Loc TileView}" Padding="12,7" ToolTip="{local:Loc TileViewHelp}"/>
          <StackPanel x:Name="PriorityReportTileScaleControls" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{local:Loc TileSize}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider x:Name="PriorityReportTileZoom" Minimum="80" Maximum="260" Value="140" Width="130" VerticalAlignment="Center" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="PriorityReportTileZoom_Changed" ToolTip="{local:Loc TileSizeHelp}"/>
            <TextBlock x:Name="PriorityReportTileZoomLabel" Text="140 px" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button Click="PriorityReportReset_Click" Content="{local:Loc ResetFilters}" Padding="12,7" Margin="0,0,0,8" ToolTip="{local:Loc ResetFiltersHelp}"/>
      </WrapPanel>
      <TextBlock Text="{local:Loc AccuracyDisclaimer}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,4,2,0" FontSize="11"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="8">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="PriorityReportGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseRightButtonDown="Finding_RightClick" SelectionChanged="PriorityReportFinding_Selected" MouseDoubleClick="PriorityReportGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{local:Loc Preview}" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="42" Height="36" Background="#18FFFFFF" CornerRadius="8" HorizontalAlignment="Center"><Grid><TextBlock Text="{Binding Category, Converter={StaticResource FileGlyphConverter}}" Foreground="#69B7FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/><local:AsyncThumbnail FilePath="{Binding Path}" Category="{Binding Category}" DecodeWidth="64" Width="38" Height="32" Stretch="Uniform"><local:AsyncThumbnail.Effect><MultiBinding Converter="{StaticResource NsfwBlurEffectConverter}"><Binding Path="MetadataJson"/><Binding ElementName="BlurNsfwThumbnailsButton" Path="IsChecked"/></MultiBinding></local:AsyncThumbnail.Effect></local:AsyncThumbnail></Grid></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{local:Loc PrivacyRisk}" Width="132"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding ObjectivePrivacyRisk}"/><TextBlock Text="|" Foreground="#77849A" Margin="1,0,1,0"/><TextBlock Text="{Binding CombinedPriority}" Foreground="#69B7FF"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="{local:Loc DetectRisk}" Binding="{Binding RiskLevel}" Width="110"/>
          <DataGridTextColumn Header="{local:Loc Type}" Binding="{Binding Category}" Width="120"/>
          <DataGridTextColumn Header="{local:Loc Name}" Binding="{Binding DisplayName}" Width="*"/>
          <DataGridTemplateColumn Header="{local:Loc PersonalModelShort}" SortMemberPath="PersonalAttentionScore" Width="150">
            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding PersonalAttentionDisplay}" Foreground="#69B7FF" Width="40" VerticalAlignment="Center"/>
              <Button Content="👍" Tag="True" Click="PersonalFeedback_Click" Padding="5,2" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=True}" Background="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackBackgroundConverter}, ConverterParameter=True}" ToolTip="{local:Loc Interesting}"/>
              <Button Content="👎" Tag="False" Click="PersonalFeedback_Click" Padding="5,2" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=False}" Background="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackBackgroundConverter}, ConverterParameter=False}" ToolTip="{local:Loc NotInteresting}"/>
              <Button Content="×" Tag="Clear" Click="PersonalFeedback_Click" Padding="5,2" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=Clear}" ToolTip="{local:Loc ClearRating}"/>
            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="DETECTIONS" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MetadataJson, Converter={StaticResource FindingBadgeConverter}}" Foreground="#FF9F0A" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="{local:Loc Size}" Binding="{Binding SizeDisplay}" Width="90"/>
          <DataGridTextColumn Header="{local:Loc Age}" Binding="{Binding AgeClass}" Width="100"/>
          <DataGridTextColumn Header="{local:Loc Modified}" Binding="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
        </DataGrid.Columns>
      </DataGrid>
      <ListBox x:Name="PriorityReportTileList" Grid.Row="0" Visibility="Collapsed" SelectionMode="Extended" Background="Transparent" BorderThickness="0" SelectionChanged="PriorityReportTile_Selected" MouseDoubleClick="PriorityReportTile_DoubleClick" Tag="{Binding ElementName=PriorityReportTileZoom, Path=Value}" PreviewMouseRightButtonDown="Finding_RightClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
          <Border Width="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Tag}" Height="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Tag}" Background="#18FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <local:AsyncThumbnail FilePath="{Binding Path}" Category="{Binding Category}" DecodeWidth="256" Stretch="Uniform"><local:AsyncThumbnail.Effect><MultiBinding Converter="{StaticResource NsfwBlurEffectConverter}"><Binding Path="MetadataJson"/><Binding ElementName="BlurNsfwThumbnailsButton" Path="IsChecked"/></MultiBinding></local:AsyncThumbnail.Effect></local:AsyncThumbnail>
              <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,5,0,0"/>
              <TextBlock Grid.Row="2" Text="{Binding MetadataJson, Converter={StaticResource FindingBadgeConverter}}" Foreground="#FF9F0A" FontSize="11" TextTrimming="CharacterEllipsis"/>
              <StackPanel Grid.Row="3" Orientation="Horizontal">
                <TextBlock Text="{Binding PersonalAttentionDisplay}" Foreground="#69B7FF" Width="35" VerticalAlignment="Center"/>
                <Button Content="👍" Tag="True" Click="PersonalFeedback_Click" Padding="3,1" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=True}" Background="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackBackgroundConverter}, ConverterParameter=True}" ToolTip="{local:Loc Interesting}"/>
                <Button Content="👎" Tag="False" Click="PersonalFeedback_Click" Padding="3,1" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=False}" Background="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackBackgroundConverter}, ConverterParameter=False}" ToolTip="{local:Loc NotInteresting}"/>
                <Button Content="×" Tag="Clear" Click="PersonalFeedback_Click" Padding="3,1" Margin="1" Opacity="{Binding PersonalAttentionLabel, Converter={StaticResource FeedbackOpacityConverter}, ConverterParameter=Clear}" ToolTip="{local:Loc ClearRating}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Row="1" Margin="8,8,8,2">
        <StackPanel Orientation="Horizontal"><Button x:Name="PriorityReportPreviousButton" Click="PriorityReportPreviousPage_Click" Content="{local:Loc PreviousPage}" Padding="12,7" ToolTip="{local:Loc PreviousPageHelp}"/><Button x:Name="PriorityReportNextButton" Click="PriorityReportNextPage_Click" Content="{local:Loc NextPage}" Padding="12,7" ToolTip="{local:Loc NextPageHelp}"/></StackPanel>
        <TextBlock x:Name="PriorityReportPageStatus" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
      </Grid>
    </Border>
  </Grid>
</TabItem>

<TabItem x:Name="TabFindings" Header="{local:Loc NavFindings}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    
    <!-- Tab Header with Title and Prominent Legend Button -->
    <DockPanel Margin="0,0,0,16">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{local:Loc FindingsTitle}" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="{local:Loc FindingsDescription}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>
      <Button x:Name="FindingsLegendToggle" DockPanel.Dock="Right" Click="FindingsLegendToggle_Click" Content="{local:Loc LegendButton}" Padding="14,8" FontSize="12" FontWeight="SemiBold" Background="#1C0A84FF" Foreground="#69B7FF" BorderThickness="1" BorderBrush="#3D0A84FF" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{local:Loc LegendTitle}"/>
    </DockPanel>

    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,14"><StackPanel>
      <!-- Expandable Legend & Information Panel -->
      <Border x:Name="FindingsLegendPanel" Background="#0C121E" BorderBrush="#24344D" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="{local:Loc LegendTitle}" FontWeight="SemiBold" FontSize="12.5" Foreground="#69B7FF"/>
            <Button DockPanel.Dock="Right" Click="FindingsLegendToggle_Click" Content="✕" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Padding="4,0" ToolTip="{local:Loc AboutClose}"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="{local:Loc LegendSectionDropdowns}" FontWeight="SemiBold" FontSize="11" Foreground="#929AAA" Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" LineHeight="16" Foreground="#BAC5D6" Margin="0,0,0,8">
                <Bold Foreground="#FFFFFF"><Run Text="• "/><Run Text="{local:Loc AllRisks}"/><Run Text=":"/></Bold> <Run Text="{local:Loc RiskFilterHelp}"/><LineBreak/>
                <Bold Foreground="#FFFFFF"><Run Text="• "/><Run Text="{local:Loc AllCategories}"/><Run Text=":"/></Bold> <Run Text="{local:Loc CategoryFilterHelp}"/>
              </TextBlock>
              <TextBlock Text="{local:Loc LegendSectionScanners}" FontWeight="SemiBold" FontSize="11" Foreground="#929AAA" Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" LineHeight="16" Foreground="#BAC5D6">
                <Bold Foreground="#69B7FF"><Run Text="• "/><Run Text="{local:Loc SearchPii}"/><Run Text=":"/></Bold> <Run Text="{local:Loc PiiScanHelp}"/><LineBreak/>
                <Bold Foreground="#FFB340"><Run Text="• "/><Run Text="{local:Loc SearchSecrets}"/><Run Text=":"/></Bold> <Run Text="{local:Loc SecretsScanHelp}"/><LineBreak/>
