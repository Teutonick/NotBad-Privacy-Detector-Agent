<UserControl x:Class="PrivacyAudit.DocumentViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrivacyAudit"
        Background="#080B12"
        Foreground="#F7F8FA"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title / Header Bar -->
        <Border Grid.Row="0" Background="#0D111A" Padding="20,16" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#18FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="lblDocIcon" Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="lblDocTitle" Text="Document" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock x:Name="lblDocSubtitle" Text="NotBad Privacy Detector Agent" FontSize="11" Foreground="#929AAA" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Document Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#080B12">
            <TextBox x:Name="txtContent"
                     Background="Transparent"
                     Foreground="#DCE3EE"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Segoe UI, monospace"
                     FontSize="12.5"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Padding="24,20"
                     AcceptsReturn="True"
                     SpellCheck.IsEnabled="False"
                     CaretBrush="Transparent"
                     SelectionBrush="#0A84FF" />
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#0D111A" Padding="20,12" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblDocNote" Grid.Column="0"
                           Text="{local:Loc AboutDocNote}"
                           FontSize="11" Foreground="#687386" VerticalAlignment="Center" />
                <Button x:Name="btnClose" Grid.Column="1"
                        Content="{local:Loc Close}"
                        Padding="18,7" FontSize="12" FontWeight="SemiBold"
                        Background="#20FFFFFF" Foreground="#F7F8FA"
                        Click="BtnClose_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
