<UserControl x:Class="PrivacyAudit.IncorrectDetectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrivacyAudit">
  <Grid Width="680" MaxHeight="650">
    <StackPanel x:Name="IntroPanel" Margin="20,12,20,20">
      <TextBlock Text="{local:Loc IncorrectDetectionQuestion}" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="{local:Loc IncorrectDetectionIntro}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#AEB8C8"/>
      <Border Background="#102D2036" BorderBrush="#445C3A69" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,14">
        <TextBlock Text="{local:Loc ReportNoContents}" Foreground="#C6A8E8" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="{local:Loc UserExplanationPrompt}" FontSize="16" FontWeight="Bold" Foreground="#FFD27A" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBox x:Name="UserExplanationBox" MinHeight="82" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="{local:Loc UserExplanationTooltip}" Padding="9"/>
      <TextBlock Text="{local:Loc UserCorrection}" Margin="0,0,0,5"/>
      <ComboBox x:Name="CorrectionBox" SelectedIndex="0" ToolTip="{local:Loc UserCorrectionTooltip}">
        <ComboBoxItem Content="{local:Loc CorrectionWrongFinding}"/>
        <ComboBoxItem Content="{local:Loc CorrectionWrongOrigin}"/>
        <ComboBoxItem Content="{local:Loc CorrectionWrongRisk}"/>
        <ComboBoxItem Content="{local:Loc CorrectionOther}"/>
      </ComboBox>
      <Button Content="{local:Loc PrepareReport}" Click="Prepare_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="18,8" Background="#49306A" BorderBrush="#7650A6" ToolTip="{local:Loc PrepareReportTooltip}"/>
    </StackPanel>

    <Grid x:Name="PreviewPanel" Visibility="Collapsed" Margin="20,10,20,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="REPORT PREVIEW" FontSize="19" FontWeight="Bold" Foreground="#B78CFF"/>
        <TextBlock Text="{local:Loc ReportPreviewDescription}" Foreground="#AEB8C8" TextWrapping="Wrap" Margin="0,5,0,10"/>
      </StackPanel>
      <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Background="#090D15" BorderBrush="#343D50" Padding="10"/>
      <Border Grid.Row="2" Background="#35A66B00" BorderBrush="#D69A28" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,10">
        <TextBlock Text="{local:Loc GithubPublicWarning}" TextWrapping="Wrap" Foreground="#FFD27A" FontWeight="SemiBold"/>
      </Border>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{local:Loc Cancel}" Click="Cancel_Click" Margin="0,0,8,0" Padding="14,7" ToolTip="{local:Loc CancelReportTooltip}"/>
        <Button Content="{local:Loc OpenGithubReport}" Click="OpenGithub_Click" Padding="14,7" Background="#49306A" BorderBrush="#7650A6" ToolTip="{local:Loc OpenGithubReportTooltip}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
