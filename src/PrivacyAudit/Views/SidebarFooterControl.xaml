<UserControl x:Class="PrivacyAudit.SidebarFooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrivacyAudit"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <StackPanel>
        <!-- Global Activity Spinner Card (Visible when any heavy task is running) -->
        <Border x:Name="bdrGlobalBusy"
                Background="#140A84FF"
                BorderBrush="#2E0A84FF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <DockPanel>
                <ProgressBar IsIndeterminate="True" Width="28" Height="4" Margin="0,3,8,0" DockPanel.Dock="Left" VerticalAlignment="Top"/>
                <TextBlock x:Name="lblGlobalBusyText" Text="{local:Loc GlobalProcessRunning}" FontSize="10" FontWeight="SemiBold" Foreground="#69B7FF" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="14"/>
            </DockPanel>
        </Border>

        <!-- Rotating privacy and performance recommendations -->
        <Border x:Name="bdrRecommendation"
                Background="#120E0920"
                BorderBrush="#55412A78"
                BorderThickness="1"
                CornerRadius="8"
                Padding="9,7"
                Margin="0,0,0,8"
                ToolTip="{local:Loc RecommendationsTooltip}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="✦" DockPanel.Dock="Right" Foreground="#B78CFF" FontSize="10"/>
                    <TextBlock Text="{local:Loc RecommendationsTitle}" Foreground="#B78CFF" FontSize="9.5" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock x:Name="lblRecommendationText" Foreground="#B9A8D5" FontSize="9.5" TextWrapping="Wrap" LineHeight="13"/>
            </StackPanel>
        </Border>

        <!-- Author Projects Promo Banner (Rotating) -->
        <Border x:Name="bdrAuthorPromo"
                Background="#0D131F"
                BorderBrush="#202A3D"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6"
                Margin="0,0,0,8"
                Cursor="Hand"
                MouseLeftButtonUp="BdrAuthorPromo_MouseLeftButtonUp"
                MouseEnter="BdrAuthorPromo_MouseEnter"
                MouseLeave="BdrAuthorPromo_MouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#131B2A" />
                            <Setter Property="BorderBrush" Value="#2F3E5A" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Header Line: "Также от автора" + Indicator -->
                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <TextBlock Text="↗" DockPanel.Dock="Right" FontSize="9" FontWeight="Bold" Foreground="#687386" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="lblAuthorPromoHeader" Text="{local:Loc AuthorProjectsTitle}" FontSize="9.5" FontWeight="SemiBold" Foreground="#687386" />
                        <TextBlock x:Name="lblAuthorPromoCounter" Text=" (1/2)" FontSize="9" FontWeight="Medium" Foreground="#556073" Margin="2,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Project Icon -->
                <TextBlock x:Name="lblAuthorPromoIcon" Grid.Row="1" Grid.Column="0" Text="🌐" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />

                <!-- Project Content: Title + Description -->
                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="#18FFFFFF" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblAuthorPromoLink" Text="tnick.cc/ai360" FontSize="8.5" Foreground="#7A879B" MaxWidth="75" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock x:Name="lblAuthorPromoTitle" Text="AI360" FontSize="11" FontWeight="SemiBold" Foreground="#BAC5D6" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="lblAuthorPromoDesc" Text="Умное приложение 360°" FontSize="9.5" Foreground="#687386" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- About Button (Opens sleek menu with Disclaimer, Privacy, Third-Party, GitHub) -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
        <Button x:Name="btnAbout"
                Grid.Column="0"
                Content="{local:Loc AboutButton}"
                Click="BtnAbout_Click"
                HorizontalContentAlignment="Center"
                FontSize="10"
                Padding="6,5"
                Margin="0,0,4,0"
                Background="#08FFFFFF"
                Foreground="#687386"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                ToolTip="{local:Loc AboutButton}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#15FFFFFF" />
                            <Setter TargetName="bdr" Property="BorderBrush" Value="#2E3D56" />
                            <Setter Property="Foreground" Value="#A0ADC2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="btnLanguage"
                Grid.Column="1"
                Content="EN"
                Click="BtnLanguage_Click"
                HorizontalContentAlignment="Center"
                FontSize="10"
                Padding="2,5"
                Background="#08FFFFFF"
                Foreground="#687386"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                ToolTip="{local:Loc LanguageSwitchTooltip}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdrLanguage"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdrLanguage" Property="Background" Value="#15FFFFFF" />
                            <Setter TargetName="bdrLanguage" Property="BorderBrush" Value="#2E3D56" />
                            <Setter Property="Foreground" Value="#A0ADC2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        </Grid>
        <Button x:Name="btnCleanup"
                Content="{local:Loc CleanupButton}"
                Click="BtnCleanup_Click"
                HorizontalContentAlignment="Center"
                FontSize="10"
                Padding="8,5"
                Margin="0,6,0,0"
                Background="#22A33A47"
                Foreground="#D99AA3"
                BorderBrush="#35D05A68"
                BorderThickness="1"/>
    </StackPanel>
</UserControl>
