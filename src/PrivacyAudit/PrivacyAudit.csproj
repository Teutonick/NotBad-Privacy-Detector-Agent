<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NotBadPrivacyDetectorAgent</AssemblyName>
    <RootNamespace>PrivacyAudit</RootNamespace>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PrivacyAudit.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.ML" Version="4.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PrivacyAudit.png" />
    <Resource Include="Assets\PrivacyAudit.ico" />
    <Resource Include="Assets\intro-slide-1.jpg" />
    <Resource Include="Assets\intro-slide-2.jpg" />
    <Resource Include="Assets\intro-slide-3.jpg" />
    <EmbeddedResource Include="..\..\docs\DISCLAIMER.md" Link="Docs\DISCLAIMER.md" />
    <EmbeddedResource Include="..\..\docs\PRIVACY.md" Link="Docs\PRIVACY.md" />
    <EmbeddedResource Include="..\..\docs\THIRD_PARTY_NOTICES.md" Link="Docs\THIRD_PARTY_NOTICES.md" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="obj\**\*.cs;bin\**\*.cs;artifacts\**\*.cs" />
  </ItemGroup>
</Project>
